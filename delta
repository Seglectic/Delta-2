#!/bin/bash
# delta — configurator for the delta modifier key system
# Usage: delta apply | reload | status
#
# apply   reads delta.conf and regenerates /etc/keyd/default.conf
#         and the KWin script, then reloads both
# reload  reloads keyd + KWin script without regenerating
# status  shows current state of all components

DELTA_DIR="$(cd "$(dirname "$0")" && pwd)"
CONF="$DELTA_DIR/delta.conf"
KWIN_SCRIPT="$HOME/.local/share/kwin/scripts/delta-tile/contents/code/main.js"
KEYD_CONF="/etc/keyd/default.conf"
LAUNCHER_SCRIPT="$DELTA_DIR/delta-launcher"
SYSTEMD_USER_DIR="$HOME/.config/systemd/user"
LAUNCHER_UNIT="$SYSTEMD_USER_DIR/delta-launch@.service"
XREMAP_CONF="$HOME/.config/xremap/config.yml"
XREMAP_SERVICE="$SYSTEMD_USER_DIR/xremap.service"
XREMAP_APPBINDINGS_CONF="$HOME/.config/xremap/app-bindings.yml"
XREMAP_APPBINDINGS_SERVICE="$SYSTEMD_USER_DIR/xremap-appbindings.service"

# ─── Config parser ─────────────────────────────────────────────────────────────
# Prints lines from a named [section], stripping comments and blank lines
get_section() {
    local section="$1" in_section=0
    while IFS= read -r line; do
        [[ "$line" =~ ^[[:space:]]*# || -z "${line// }" ]] && continue
        if [[ "$line" =~ ^\[(.+)\]$ ]]; then
            [[ "${BASH_REMATCH[1]}" == "$section" ]] && in_section=1 || in_section=0
            continue
        fi
        [[ $in_section -eq 1 ]] && echo "$line"
    done < "$CONF"
}

get_value() {
    get_section "$1" | grep "^${2}[[:space:]]*=" | cut -d= -f2- | tr -d ' '
}

# ─── Generators ────────────────────────────────────────────────────────────────
generate_keyd() {
    local kbd_id mod_key
    kbd_id=$(get_value "device" "keyboard_id")
    mod_key=$(get_value "device" "modifier_key")
    [[ -z "$mod_key" ]] && mod_key="f20"
    echo "[ids]"
    echo "${kbd_id:-*}"
    echo ""
    echo "[main]"
    echo "${mod_key,,} = layer(delta)"
    echo ""
    echo "[delta]"
    while IFS='=' read -r id rest; do
        id="${id// /}"
        read -r key _ <<< "$rest"
        echo "${key,,} = C-A-M-${key,,}"
    done < <(get_section "bindings")
}

generate_kwin() {
    cat << 'HEADER'
// Delta Tile — KWin script
// Generated by: ~/.local/bin/delta/delta apply
// Edit ~/.local/bin/delta/delta.conf, not this file.

HEADER

    # Build windowOverrides object from [overrides] section
    echo "var windowOverrides = {};"
    while IFS='=' read -r appkey rest; do
        appkey="${appkey// /}"
        [[ -z "$appkey" ]] && continue
        local app="${appkey%%.*}"
        local action="${appkey##*.}"
        read -r xf wf <<< "$rest"
        echo "if (!windowOverrides[\"$app\"]) windowOverrides[\"$app\"] = {};"
        echo "windowOverrides[\"$app\"][\"${action,,}\"] = [$xf, $wf];"
    done < <(get_section "overrides")

    local ignore_fullscreen ignored_desktop_files ignored_classes
    ignore_fullscreen=$(get_value "guards" "ignore_fullscreen")
    ignored_desktop_files=$(get_value "guards" "ignored_desktop_files")
    ignored_classes=$(get_value "guards" "ignored_classes")
    [[ -z "$ignore_fullscreen" ]] && ignore_fullscreen="true"
    echo "var deltaDebug = false;"
    echo "var ignoreFullscreen = ${ignore_fullscreen,,};"
    if [[ -n "$ignored_desktop_files" ]]; then
        echo "var ignoredDesktopFiles = [$(printf '"%s"' "${ignored_desktop_files//,/\",\"}")];"
    else
        echo "var ignoredDesktopFiles = [];"
    fi
    if [[ -n "$ignored_classes" ]]; then
        echo "var ignoredClasses = [$(printf '"%s"' "${ignored_classes//,/\",\"}")];"
    else
        echo "var ignoredClasses = [];"
    fi

    cat << 'FUNCS'

function tile(action, defaultX, defaultW) {
    var w = workspace.activeWindow;
    if (!w) return;
    if (shouldIgnoreWindow(w)) return;
    var xf = defaultX, wf = defaultW;
    var ov = windowOverrides[w.resourceClass];
    if (ov && ov[action]) { xf = ov[action][0]; wf = ov[action][1]; }
    w.setMaximize(false, false);
    var area = workspace.clientArea(KWin.MaximizeArea, w);
    w.frameGeometry = {
        x: area.x + Math.round(area.width * xf), y: area.y,
        width: Math.round(area.width * wf),       height: area.height
    };
}

function tileFixed(fw, fh) {
    var w = workspace.activeWindow;
    if (!w) return;
    if (shouldIgnoreWindow(w)) return;
    w.setMaximize(false, false);
    var area = workspace.clientArea(KWin.MaximizeArea, w);
    w.frameGeometry = {
        x: area.x + Math.round((area.width  - fw) / 2),
        y: area.y + Math.round((area.height - fh) / 2),
        width: fw, height: fh
    };
}

function logDelta(message) {
    if (deltaDebug) {
        print("DELTA: " + message);
    }
}

var tileInsets = {
    left: 2,
    top: 4,
    right: 4,
    bottom: 4
};

function normalizedString(value) {
    if (!value) return "";
    return ("" + value).toLowerCase();
}

function arrayContainsNormalized(list, value) {
    var i;
    var needle = normalizedString(value);
    if (!needle) return false;
    for (i = 0; i < list.length; ++i) {
        if (normalizedString(list[i]) === needle) {
            return true;
        }
    }
    return false;
}

function shouldIgnoreWindow(w) {
    if (!w) return true;
    if (w.desktopWindow || w.windowType === 1) return true;
    if (ignoreFullscreen && w.fullScreen) {
        return true;
    }
    if (arrayContainsNormalized(ignoredDesktopFiles, w.desktopFileName || w.desktopFile)) {
        return true;
    }
    if (arrayContainsNormalized(ignoredClasses, w.resourceClass)) {
        return true;
    }
    return false;
}

function approx(a, b) {
    return Math.abs(a - b) < 0.01;
}

function clearTiles(rootTile) {
    while (rootTile.tiles.length > 0) {
        rootTile.tiles[0].remove();
    }
}

function splitHorizontal(rootTile) {
    var candidates = [];
    var i;
    var value;
    var label;

    if (typeof KWin !== "undefined" && typeof KWin.Horizontal !== "undefined") {
        candidates.push(["KWin.Horizontal", KWin.Horizontal]);
    }
    if (typeof Tile !== "undefined" && typeof Tile.Horizontal !== "undefined") {
        candidates.push(["Tile.Horizontal", Tile.Horizontal]);
    }
    candidates.push(["numeric 0", 0]);
    candidates.push(["numeric 1", 1]);
    candidates.push(["numeric 2", 2]);

    for (i = 0; i < candidates.length; ++i) {
        label = candidates[i][0];
        value = candidates[i][1];
        clearTiles(rootTile);
        rootTile.split(value);
        logDelta("splitHorizontal: tried " + label + ", tiles=" + rootTile.tiles.length);
        if (rootTile.tiles.length === 2) {
            return true;
        }
    }

    logDelta("splitHorizontal: no candidate produced 2 tiles");
    return false;
}

function layoutLeftWidth(layoutName) {
    if (layoutName === "halves") {
        return 0.5;
    }
    if (layoutName === "thirds_left") {
        return 1 / 3;
    }
    if (layoutName === "thirds_right") {
        return 2 / 3;
    }
    return -1;
}

function ensureTwoColumnLayout(rootTile, layoutName) {
    var leftWidth = layoutLeftWidth(layoutName);
    if (leftWidth < 0) {
        logDelta("ensureTwoColumnLayout: unknown layout " + layoutName);
        return false;
    }

    if (rootTile.tiles.length === 2 &&
        approx(rootTile.tiles[0].relativeGeometry.x, 0) &&
        approx(rootTile.tiles[0].relativeGeometry.width, leftWidth) &&
        approx(rootTile.tiles[1].relativeGeometry.x, leftWidth) &&
        approx(rootTile.tiles[1].relativeGeometry.width, 1 - leftWidth)) {
        return true;
    }

    clearTiles(rootTile);
    if (!splitHorizontal(rootTile)) {
        return false;
    }
    logDelta("ensureTwoColumnLayout(" + layoutName + "): after split tiles=" + rootTile.tiles.length);
    if (!rootTile.tiles[0] || !rootTile.tiles[1]) {
        logDelta("ensureTwoColumnLayout(" + layoutName + "): missing tiles after split");
        return false;
    }
    rootTile.tiles[0].relativeGeometry = {
        x: 0,
        y: 0,
        width: leftWidth,
        height: 1
    };
    rootTile.tiles[1].relativeGeometry = {
        x: leftWidth,
        y: 0,
        width: 1 - leftWidth,
        height: 1
    };
    logDelta(
        "ensureTwoColumnLayout(" + layoutName + "): left=(" +
        rootTile.tiles[0].relativeGeometry.x + "," + rootTile.tiles[0].relativeGeometry.width +
        ") right=(" +
        rootTile.tiles[1].relativeGeometry.x + "," + rootTile.tiles[1].relativeGeometry.width + ")"
    );
    return rootTile.tiles.length === 2;
}

function manageIntoTile(tile, window) {
    var geom = null;
    var area = null;
    if (!tile || !window) return;
    if (typeof tile.manage === "function") {
        tile.manage(window);
    } else {
        window.tile = tile;
    }
    if (typeof workspace.scheduleRearrange === "function") {
        workspace.scheduleRearrange();
    } else if (typeof workspace.rearrange === "function") {
        workspace.rearrange();
    }
    area = workspace.clientArea(KWin.MaximizeArea, window);
    if (area && tile.relativeGeometry) {
        geom = {
            x: Math.round(area.x + area.width * tile.relativeGeometry.x) + tileInsets.left,
            y: Math.round(area.y + area.height * tile.relativeGeometry.y) + tileInsets.top,
            width: Math.round(area.width * tile.relativeGeometry.width) - tileInsets.left - tileInsets.right,
            height: Math.round(area.height * tile.relativeGeometry.height) - tileInsets.top - tileInsets.bottom
        };
        window.frameGeometry = {
            x: geom.x,
            y: geom.y,
            width: geom.width,
            height: geom.height
        };
    } else if (tile.absoluteGeometryInScreen) {
        geom = tile.absoluteGeometryInScreen;
        window.frameGeometry = {
            x: geom.x,
            y: geom.y,
            width: geom.width,
            height: geom.height
        };
    }
}

function tileIntoLayout(layoutName, side, targetWindow) {
    var w = targetWindow || workspace.activeWindow;
    var manager;
    var rootTile;
    var slotIndex;

    if (!w || !w.output) return;
    if (shouldIgnoreWindow(w)) return;

    manager = workspace.tilingForScreen(w.output.name);
    if (!manager || !manager.rootTile) return;
    rootTile = manager.rootTile;

    if (!ensureTwoColumnLayout(rootTile, layoutName)) return;

    slotIndex = side === "right" ? 1 : 0;

    w.setMaximize(false, false);
    manageIntoTile(rootTile.tiles[slotIndex], w);
}

var pendingAppActions = {};

function windowMatchesProfile(w, profile) {
    var desktopFile = normalizedString(w.desktopFileName || w.desktopFile);
    var resourceClass = normalizedString(w.resourceClass);
    var caption = normalizedString(w.caption);

    if (profile === "discord") {
        return desktopFile.indexOf("com.discordapp.discord") >= 0 ||
               resourceClass.indexOf("discord") >= 0 ||
               caption.indexOf("discord") >= 0;
    }
    if (profile === "obsidian") {
        return desktopFile.indexOf("md.obsidian.obsidian") >= 0 ||
               resourceClass.indexOf("obsidian") >= 0 ||
               caption.indexOf("obsidian") >= 0;
    }
    if (profile === "code") {
        return desktopFile === "code" ||
               desktopFile.indexOf("code.desktop") >= 0 ||
               resourceClass === "code" ||
               resourceClass === "vscode" ||
               caption.indexOf("visual studio code") >= 0;
    }
    if (profile === "konsole") {
        return desktopFile.indexOf("org.kde.konsole") >= 0 ||
               resourceClass.indexOf("konsole") >= 0 ||
               caption.indexOf("konsole") >= 0;
    }
    return false;
}

function focusWindow(w) {
    if (!w) return;
    if (w.minimized) {
        w.minimized = false;
    }
    workspace.raiseWindow(w);
    workspace.activeWindow = w;
    workspace.activateWindow(w, true);
    if (typeof workspace.requestFocus === "function") {
        workspace.requestFocus(w, true);
    }
    if (typeof w.takeFocus === "function") {
        w.takeFocus();
    }
    setTimeout(function() {
        workspace.raiseWindow(w);
        workspace.activeWindow = w;
        workspace.activateWindow(w, true);
        if (typeof workspace.requestFocus === "function") {
            workspace.requestFocus(w, true);
        }
        if (typeof w.takeFocus === "function") {
            w.takeFocus();
        }
    }, 50);
}

function toggleMinimizeIfActive(w) {
    if (!w) return false;
    if (workspace.activeWindow === w || w.active) {
        if (w.minimizable) {
            w.minimized = true;
        }
        return true;
    }
    return false;
}

function applyAppAction(profile, w) {
    logDelta("applyAppAction(" + profile + "): focusing window " + normalizedString(w.caption));
    if (profile === "discord") {
        logDelta("applyAppAction(discord): tiling to left third");
        tileIntoLayout("thirds_left", "left", w);
    }
    focusWindow(w);
}

function findWindowForProfile(profile) {
    var windows = workspace.stackingOrder;
    var i;
    var minimizedMatch = null;
    for (i = windows.length - 1; i >= 0; --i) {
        if (windows[i] && !windows[i].deleted && windowMatchesProfile(windows[i], profile)) {
            if (!windows[i].minimized) {
                logDelta("findWindowForProfile(" + profile + "): matched " + normalizedString(windows[i].caption));
                return windows[i];
            }
            if (!minimizedMatch) {
                minimizedMatch = windows[i];
            }
        }
    }
    if (minimizedMatch) {
        logDelta("findWindowForProfile(" + profile + "): matched minimized " + normalizedString(minimizedMatch.caption));
        return minimizedMatch;
    }
    logDelta("findWindowForProfile(" + profile + "): no match");
    return null;
}

function launchProfile(profile) {
    logDelta("launchProfile(" + profile + ")");
    pendingAppActions[profile] = true;
    callDBus(
        "org.freedesktop.systemd1",
        "/org/freedesktop/systemd1",
        "org.freedesktop.systemd1.Manager",
        "StartUnit",
        "delta-launch@" + profile + ".service",
        "replace"
    );
}

function focusOrLaunch(profile) {
    logDelta("focusOrLaunch(" + profile + ")");
    var existing = findWindowForProfile(profile);
    if (existing) {
        if (toggleMinimizeIfActive(existing)) {
            logDelta("focusOrLaunch(" + profile + "): minimized active window");
            return;
        }
        applyAppAction(profile, existing);
        return;
    }
    launchProfile(profile);
}

workspace.windowAdded.connect(function(window) {
    var profile;
    for (profile in pendingAppActions) {
        if (pendingAppActions[profile] && windowMatchesProfile(window, profile)) {
            logDelta("windowAdded: matched pending profile " + profile);
            pendingAppActions[profile] = false;
            applyAppAction(profile, window);
            return;
        }
    }
});

FUNCS

    while IFS='=' read -r id rest; do
        id="${id// /}"
        read -r key xf wf extra <<< "$rest"
        local ku="$key" kl="${key,,}"
        [[ ${#key} -eq 1 ]] && ku="${key^^}"
        if [[ "$xf" == "fixed" ]]; then
            echo "registerShortcut(\"${id}\", \"Delta: ${id}\", \"Ctrl+Alt+Meta+${ku}\", function() { tileFixed(${wf}, ${extra}); });"
        elif [[ "$xf" == "tile" ]]; then
            echo "registerShortcut(\"${id}\", \"Delta: ${id}\", \"Ctrl+Alt+Meta+${ku}\", function() { tileIntoLayout(\"${wf}\", \"${extra}\"); });"
        elif [[ "$xf" == "app" ]]; then
            echo "registerShortcut(\"${id}\", \"Delta: ${id}\", \"Ctrl+Alt+Meta+${ku}\", function() { focusOrLaunch(\"${wf}\"); });"
        else
            echo "registerShortcut(\"${id}\", \"Delta: ${id}\", \"Ctrl+Alt+Meta+${ku}\", function() { tile(\"${kl}\", ${xf}, ${wf}); });"
        fi
    done < <(get_section "bindings")

    # Aliases — bare keys that fire the same action as an existing binding
    local _aid _akey _orig _okey _xf _wf _extra _ku
    while IFS='=' read -r _aid _akey; do
        _aid="${_aid// /}"; _akey="${_akey// /}"
        [[ -z "$_aid" || -z "$_akey" ]] && continue
        _orig=$(get_section "bindings" | grep -E "^${_aid}[[:space:]]*=")
        [[ -z "$_orig" ]] && continue
        read -r _okey _xf _wf _extra <<< "${_orig#*=}"
        [[ ${#_akey} -eq 1 ]] && _ku="${_akey^^}" || _ku="$_akey"
        if [[ "$_xf" == "app" ]]; then
            echo "registerShortcut(\"${_aid}_${_akey}\", \"Delta: ${_aid} (${_akey})\", \"${_ku}\", function() { focusOrLaunch(\"${_wf}\"); });"
        elif [[ "$_xf" == "fixed" ]]; then
            echo "registerShortcut(\"${_aid}_${_akey}\", \"Delta: ${_aid} (${_akey})\", \"${_ku}\", function() { tileFixed(${_wf}, ${_extra}); });"
        elif [[ "$_xf" == "tile" ]]; then
            echo "registerShortcut(\"${_aid}_${_akey}\", \"Delta: ${_aid} (${_akey})\", \"${_ku}\", function() { tileIntoLayout(\"${_wf}\", \"${_extra}\"); });"
        else
            echo "registerShortcut(\"${_aid}_${_akey}\", \"Delta: ${_aid} (${_akey})\", \"${_ku}\", function() { tile(\"${_okey,,}\", ${_xf}, ${_wf}); });"
        fi
    done < <(get_section "aliases")
}

generate_launcher_unit() {
    cat <<UNIT
[Unit]
Description=Delta app launcher for %i

[Service]
Type=oneshot
ExecStart=$LAUNCHER_SCRIPT %i
UNIT
}

generate_launcher_script() {
    echo "#!/bin/bash"
    echo "set -euo pipefail"
    echo ""
    echo "case \"\${1:-}\" in"
    while IFS='=' read -r profile cmd; do
        profile="${profile// /}"
        cmd="${cmd# }"
        [[ -z "$profile" ]] && continue
        echo "    ${profile})"
        echo "        exec /usr/bin/systemd-run --user --scope --quiet ${cmd} ;;"
    done < <(get_section "launchers")
    echo "    *)"
    echo "        echo \"Unknown delta app profile: \${1:-}\" >&2"
    echo "        exit 1 ;;"
    echo "esac"
}

generate_xremap() {
    local mod_key xmod
    mod_key=$(get_value "device" "modifier_key")
    [[ -z "$mod_key" ]] && mod_key="capslock"
    case "${mod_key,,}" in
        capslock) xmod="CapsLock" ;;
        f20)      xmod="KEY_F20"  ;;
        *)        xmod="$mod_key" ;;
    esac

    # NOTE: The modmap held+keymap chaining relies on xremap treating KEY_F20 as a
    # virtual modifier. Verified on xremap >=0.10 with --features kde. If combos don't
    # fire, check: systemctl --user status xremap and journalctl --user -u xremap -f
    printf 'modmap:\n'
    printf '  - name: delta-modifier\n'
    printf '    remap:\n'
    printf '      %s:\n' "$xmod"
    printf '        held: KEY_F20\n'
    printf '        alone: %s\n' "$xmod"
    printf '\n'
    printf 'keymap:\n'
    printf '  - name: delta-layer\n'
    printf '    remap:\n'

    while IFS='=' read -r id rest; do
        id="${id// /}"
        read -r key _ <<< "$rest"
        local xkey
        case "${key,,}" in
            left)  xkey="Left"  ;;
            right) xkey="Right" ;;
            up)    xkey="Up"    ;;
            down)  xkey="Down"  ;;
            *)     xkey="${key,,}" ;;
        esac
        printf '      KEY_F20-%s: Ctrl-Alt-Super-%s\n' "$xkey" "$xkey"
    done < <(get_section "bindings")

    _emit_xremap_appbindings
}

generate_xremap_appbindings() {
    printf 'keymap:\n'
    _emit_xremap_appbindings
}

# Shared helper — emits app-specific keymap blocks in xremap format.
# Called by generate_xremap (appended to main config) and generate_xremap_appbindings (standalone).
_emit_xremap_appbindings() {
    local _cur_app="" _appkey _app _key _target
    while IFS='=' read -r _appkey _target; do
        _appkey="${_appkey// /}"
        _target="${_target// /}"
        [[ -z "$_appkey" || -z "$_target" ]] && continue
        _app="${_appkey%%.*}"
        _key="${_appkey##*.}"
        _target="${_target//+/-}"
        if [[ "$_app" != "$_cur_app" ]]; then
            printf '\n  - name: %s-appkeys\n' "$_app"
            printf '    application:\n'
            printf '      only: ["%s"]\n' "$_app"
            printf '    remap:\n'
            _cur_app="$_app"
        fi
        printf '      %s: %s\n' "$_key" "$_target"
    done < <(get_section "app_bindings")
}

_has_app_bindings() {
    [[ -n "$(get_section "app_bindings")" ]]
}

_install_xremap_appbindings_service() {
    local xremap_bin
    xremap_bin=$(command -v xremap 2>/dev/null || echo "$HOME/.local/bin/xremap")
    mkdir -p "$(dirname "$XREMAP_APPBINDINGS_SERVICE")"
    cat > "$XREMAP_APPBINDINGS_SERVICE" <<UNIT
[Unit]
Description=xremap app-specific key bindings (delta)

[Service]
ExecStart=${xremap_bin} ${XREMAP_APPBINDINGS_CONF}
Restart=on-failure

[Install]
WantedBy=default.target
UNIT
}

# ─── Commands ──────────────────────────────────────────────────────────────────
_apply_keyd() {
    if [[ -w "$KEYD_CONF" ]]; then
        generate_keyd > "$KEYD_CONF" && keyd reload
    else
        generate_keyd | sudo tee "$KEYD_CONF" > /dev/null && sudo keyd reload
    fi
}

_restart_keyd() {
    [[ -w "$KEYD_CONF" ]] && keyd reload || sudo keyd reload
}

_is_immutable() {
    grep -q 'ID=steamos' /etc/os-release 2>/dev/null && return 0
    findmnt -n -o OPTIONS / 2>/dev/null | grep -qw 'ro' && return 0
    return 1
}

_install_xremap_service() {
    local xremap_bin
    xremap_bin=$(command -v xremap 2>/dev/null || echo "$HOME/.local/bin/xremap")
    mkdir -p "$(dirname "$XREMAP_SERVICE")"
    cat > "$XREMAP_SERVICE" <<UNIT
[Unit]
Description=xremap key remapper (delta modifier)

[Service]
ExecStart=${xremap_bin} ${XREMAP_CONF}
Restart=on-failure

[Install]
WantedBy=default.target
UNIT
}

cmd_apply() {
    local backend
    backend=$(get_value "device" "backend")
    [[ -z "$backend" ]] && backend="keyd"
    case "$backend" in
        xremap) cmd_apply_user ;;
        *)
            echo "==> Generating keyd config..."
            _apply_keyd
            echo "    wrote $KEYD_CONF"
            echo "==> Generating launcher script..."
            generate_launcher_script > "$LAUNCHER_SCRIPT"
            chmod +x "$LAUNCHER_SCRIPT"
            echo "    wrote $LAUNCHER_SCRIPT"
            if _has_app_bindings; then
                echo "==> Generating xremap app-bindings config..."
                mkdir -p "$(dirname "$XREMAP_APPBINDINGS_CONF")"
                generate_xremap_appbindings > "$XREMAP_APPBINDINGS_CONF"
                echo "    wrote $XREMAP_APPBINDINGS_CONF"
                _install_xremap_appbindings_service
                systemctl --user daemon-reload
                systemctl --user enable xremap-appbindings 2>/dev/null || true
                systemctl --user restart xremap-appbindings
                echo "    xremap-appbindings service restarted"
            fi
            echo "==> Generating KWin script..."
            mkdir -p "$(dirname "$KWIN_SCRIPT")"
            generate_kwin > "$KWIN_SCRIPT"
            _reload_kwin
            echo "    wrote $KWIN_SCRIPT"
            echo "Done."
            ;;
    esac
}

cmd_apply_user() {
    echo "==> Generating xremap config..."
    mkdir -p "$(dirname "$XREMAP_CONF")"
    generate_xremap > "$XREMAP_CONF"
    echo "    wrote $XREMAP_CONF"

    echo "==> Generating launcher script..."
    generate_launcher_script > "$LAUNCHER_SCRIPT"
    chmod +x "$LAUNCHER_SCRIPT"
    echo "    wrote $LAUNCHER_SCRIPT"

    echo "==> Installing xremap user service..."
    _install_xremap_service
    systemctl --user daemon-reload
    systemctl --user enable xremap 2>/dev/null || true
    systemctl --user restart xremap
    echo "    xremap service restarted"

    echo "==> Generating KWin script..."
    mkdir -p "$(dirname "$KWIN_SCRIPT")"
    generate_kwin > "$KWIN_SCRIPT"
    _reload_kwin
    echo "    wrote $KWIN_SCRIPT"
    echo "Done."
}

cmd_reload() {
    local backend
    backend=$(get_value "device" "backend")
    [[ -z "$backend" ]] && backend="keyd"
    case "$backend" in
        xremap)
            echo "==> Reloading xremap..."
            systemctl --user restart xremap
            ;;
        *)
            echo "==> Reloading keyd..."
            _restart_keyd
            if systemctl --user is-active --quiet xremap-appbindings 2>/dev/null; then
                echo "==> Reloading xremap app-bindings..."
                systemctl --user restart xremap-appbindings
            fi
            ;;
    esac
    echo "==> Reloading KWin script..."
    _reload_kwin
    echo "Done."
}

cmd_reload_user() {
    echo "==> Restarting xremap service..."
    systemctl --user restart xremap
    echo "Done."
}

cmd_render_kwin() {
    echo "==> Generating KWin script..."
    mkdir -p "$(dirname "$KWIN_SCRIPT")"
    generate_kwin > "$KWIN_SCRIPT"
    echo "    wrote $KWIN_SCRIPT"
}

cmd_render_launcher() {
    echo "==> Generating launcher script..."
    generate_launcher_script > "$LAUNCHER_SCRIPT"
    chmod +x "$LAUNCHER_SCRIPT"
    echo "    wrote $LAUNCHER_SCRIPT"
    echo "==> Generating launcher unit..."
    mkdir -p "$SYSTEMD_USER_DIR"
    generate_launcher_unit > "$LAUNCHER_UNIT"
    chmod 644 "$LAUNCHER_UNIT"
    echo "    wrote $LAUNCHER_UNIT"
}

cmd_reload_kwin() {
    echo "==> Reloading KWin script..."
    _reload_kwin
    echo "Done."
}

_reload_kwin() {
    qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.unloadScript "delta-tile" 2>/dev/null || true
    qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.loadScript "$KWIN_SCRIPT" "delta-tile" 2>/dev/null
    qdbus6 org.kde.KWin /Scripting start 2>/dev/null
}

cmd_status() {
    local backend kwin_loaded
    backend=$(get_value "device" "backend")
    [[ -z "$backend" ]] && backend="keyd"
    kwin_loaded=$(qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.isScriptLoaded "delta-tile" 2>/dev/null)
    echo "backend:          $backend"
    echo "kwin script:      ${kwin_loaded:-unknown}"
    echo "config:           $CONF"
    echo "kwin script path: $KWIN_SCRIPT"
    if [[ "$backend" == "xremap" ]]; then
        local xremap_state
        xremap_state=$(systemctl --user is-active xremap 2>/dev/null)
        echo "xremap service:   ${xremap_state:-unknown}"
        echo "xremap config:    $XREMAP_CONF"
    else
        local keyd_state
        keyd_state=$(systemctl is-active keyd 2>/dev/null)
        echo "keyd service:     ${keyd_state:-unknown}"
        echo "keyd config:      $KEYD_CONF"
    fi
}

AUTOSTART_FILE="$HOME/.config/autostart/delta-kwin.desktop"

cmd_render_autostart() {
    mkdir -p "$(dirname "$AUTOSTART_FILE")"
    cat > "$AUTOSTART_FILE" <<DESKTOP
[Desktop Entry]
Type=Application
Name=Delta 2 KWin Script
Exec=bash -c 'sleep 2 && $DELTA_DIR/delta reload-kwin'
X-KDE-autostart-phase=2
NoDisplay=true
DESKTOP
    echo "    wrote $AUTOSTART_FILE"
}

cmd_setup() {
    if [[ "$EUID" -ne 0 ]]; then
        echo "Run setup with sudo: sudo delta setup"; exit 1
    fi
    local user="${SUDO_USER:-$USER}"
    usermod -aG keyd "$user"
    chgrp keyd /etc/keyd
    chmod g+w /etc/keyd
    touch "$KEYD_CONF"
    chgrp keyd "$KEYD_CONF"
    chmod g+rw "$KEYD_CONF"
    echo "Setup complete."
    echo "Log out and back in for the keyd group to take effect, then run: delta apply"
}

cmd_install_xremap() {
    echo "xremap install instructions:"
    echo ""
    if _is_immutable; then
        echo "  Immutable filesystem detected (SteamOS or similar)."
        echo "  Install pre-built binary to ~/.local/bin/:"
        echo ""
        echo "    mkdir -p ~/.local/bin"
        echo "    curl -L https://github.com/xremap/xremap/releases/latest/download/xremap-linux-x86_64-kde.zip \\"
        echo "         -o /tmp/xremap.zip"
        echo "    unzip /tmp/xremap.zip -d /tmp/xremap-bin"
        echo "    cp /tmp/xremap-bin/xremap ~/.local/bin/xremap"
        echo "    chmod +x ~/.local/bin/xremap"
    else
        echo "  Option 1 — cargo (recommended if Rust is installed):"
        echo "    cargo install xremap --features kde"
        echo ""
        echo "  Option 2 — pre-built binary:"
        echo "    mkdir -p ~/.local/bin"
        echo "    curl -L https://github.com/xremap/xremap/releases/latest/download/xremap-linux-x86_64-kde.zip \\"
        echo "         -o /tmp/xremap.zip"
        echo "    unzip /tmp/xremap.zip -d /tmp/xremap-bin"
        echo "    cp /tmp/xremap-bin/xremap ~/.local/bin/xremap"
        echo "    chmod +x ~/.local/bin/xremap"
    fi
    echo ""
    echo "  After installing, set backend = xremap in delta.conf, then run: delta apply-user"
}

case "${1:-help}" in
    setup)           cmd_setup  ;;
    apply)           cmd_apply  ;;
    apply-user)      cmd_apply_user ;;
    reload)          cmd_reload ;;
    reload-user)     cmd_reload_user ;;
    install-xremap)  cmd_install_xremap ;;
    render-kwin)     cmd_render_kwin ;;
    render-launcher) cmd_render_launcher ;;
    render-autostart) cmd_render_autostart ;;
    reload-kwin)     cmd_reload_kwin ;;
    status)          cmd_status ;;
    *)
        echo "Usage: delta <command>"
        echo ""
        echo "  keyd backend (QMK keyboard, default):"
        echo "  setup             — (once, with sudo) grants passwordless access to keyd config"
        echo "  apply             — regenerate configs from delta.conf and reload everything"
        echo "  reload            — reload modifier backend + KWin script without regenerating"
        echo ""
        echo "  xremap backend (standard keyboard, work/immutable machines):"
        echo "  install-xremap    — print platform-appropriate xremap install instructions"
        echo "  apply-user        — regenerate xremap config + KWin script, restart xremap service"
        echo "  reload-user       — restart xremap service only"
        echo ""
        echo "  shared:"
        echo "  status            — show current state of all components"
        echo "  render-kwin       — regenerate only the KWin script"
        echo "  render-launcher   — regenerate the user systemd launcher unit"
        echo "  render-autostart  — regenerate the KDE autostart entry"
        echo "  reload-kwin       — reload only the KWin script"
        ;;
esac
