#!/bin/bash
# delta — configurator for the delta modifier key system
# Usage: delta apply | reload | status
#
# apply   reads delta.conf and regenerates /etc/keyd/default.conf
#         and the KWin script, then reloads both
# reload  reloads keyd + KWin script without regenerating
# status  shows current state of all components

DELTA_DIR="$(cd "$(dirname "$0")" && pwd)"
CONF="$DELTA_DIR/delta.conf"
KWIN_SCRIPT="$HOME/.local/share/kwin/scripts/delta-tile/contents/code/main.js"
KEYD_CONF="/etc/keyd/default.conf"

# ─── Config parser ─────────────────────────────────────────────────────────────
# Prints lines from a named [section], stripping comments and blank lines
get_section() {
    local section="$1" in_section=0
    while IFS= read -r line; do
        [[ "$line" =~ ^[[:space:]]*# || -z "${line// }" ]] && continue
        if [[ "$line" =~ ^\[(.+)\]$ ]]; then
            [[ "${BASH_REMATCH[1]}" == "$section" ]] && in_section=1 || in_section=0
            continue
        fi
        [[ $in_section -eq 1 ]] && echo "$line"
    done < "$CONF"
}

get_value() {
    get_section "$1" | grep "^$2" | cut -d= -f2- | tr -d ' '
}

# ─── Generators ────────────────────────────────────────────────────────────────
generate_keyd() {
    local kbd_id
    kbd_id=$(get_value "device" "keyboard_id")
    echo "[ids]"
    echo "${kbd_id:-*}"
    echo ""
    echo "[main]"
    echo "f20 = layer(delta)"
    echo ""
    echo "[delta]"
    while IFS='=' read -r id rest; do
        id="${id// /}"
        read -r key _ <<< "$rest"
        echo "${key,,} = C-A-M-${key,,}"
    done < <(get_section "bindings")
}

generate_kwin() {
    cat << 'HEADER'
// Delta Tile — KWin script
// Generated by: ~/.local/bin/delta/delta apply
// Edit ~/.local/bin/delta/delta.conf, not this file.

HEADER

    # Build windowOverrides object from [overrides] section
    echo "var windowOverrides = {};"
    while IFS='=' read -r appkey rest; do
        appkey="${appkey// /}"
        [[ -z "$appkey" ]] && continue
        local app="${appkey%%.*}"
        local action="${appkey##*.}"
        read -r xf wf <<< "$rest"
        echo "if (!windowOverrides[\"$app\"]) windowOverrides[\"$app\"] = {};"
        echo "windowOverrides[\"$app\"][\"${action,,}\"] = [$xf, $wf];"
    done < <(get_section "overrides")

    local ignore_fullscreen ignored_desktop_files ignored_classes
    ignore_fullscreen=$(get_value "guards" "ignore_fullscreen")
    ignored_desktop_files=$(get_value "guards" "ignored_desktop_files")
    ignored_classes=$(get_value "guards" "ignored_classes")
    [[ -z "$ignore_fullscreen" ]] && ignore_fullscreen="true"
    echo "var deltaDebug = false;"
    echo "var ignoreFullscreen = ${ignore_fullscreen,,};"
    if [[ -n "$ignored_desktop_files" ]]; then
        echo "var ignoredDesktopFiles = [$(printf '"%s"' "${ignored_desktop_files//,/\",\"}")];"
    else
        echo "var ignoredDesktopFiles = [];"
    fi
    if [[ -n "$ignored_classes" ]]; then
        echo "var ignoredClasses = [$(printf '"%s"' "${ignored_classes//,/\",\"}")];"
    else
        echo "var ignoredClasses = [];"
    fi

    cat << 'FUNCS'

function tile(action, defaultX, defaultW) {
    var w = workspace.activeWindow;
    if (!w) return;
    if (shouldIgnoreWindow(w)) return;
    var xf = defaultX, wf = defaultW;
    var ov = windowOverrides[w.resourceClass];
    if (ov && ov[action]) { xf = ov[action][0]; wf = ov[action][1]; }
    w.setMaximize(false, false);
    var area = workspace.clientArea(KWin.MaximizeArea, w);
    w.frameGeometry = {
        x: area.x + Math.round(area.width * xf), y: area.y,
        width: Math.round(area.width * wf),       height: area.height
    };
}

function tileFixed(fw, fh) {
    var w = workspace.activeWindow;
    if (!w) return;
    if (shouldIgnoreWindow(w)) return;
    w.setMaximize(false, false);
    var area = workspace.clientArea(KWin.MaximizeArea, w);
    w.frameGeometry = {
        x: area.x + Math.round((area.width  - fw) / 2),
        y: area.y + Math.round((area.height - fh) / 2),
        width: fw, height: fh
    };
}

function logDelta(message) {
    if (deltaDebug) {
        print("DELTA: " + message);
    }
}

var tileInsets = {
    left: 2,
    top: 4,
    right: 4,
    bottom: 4
};

function normalizedString(value) {
    if (!value) return "";
    return ("" + value).toLowerCase();
}

function arrayContainsNormalized(list, value) {
    var i;
    var needle = normalizedString(value);
    if (!needle) return false;
    for (i = 0; i < list.length; ++i) {
        if (normalizedString(list[i]) === needle) {
            return true;
        }
    }
    return false;
}

function shouldIgnoreWindow(w) {
    if (!w) return true;
    if (ignoreFullscreen && w.fullScreen) {
        return true;
    }
    if (arrayContainsNormalized(ignoredDesktopFiles, w.desktopFileName || w.desktopFile)) {
        return true;
    }
    if (arrayContainsNormalized(ignoredClasses, w.resourceClass)) {
        return true;
    }
    return false;
}

function approx(a, b) {
    return Math.abs(a - b) < 0.01;
}

function clearTiles(rootTile) {
    while (rootTile.tiles.length > 0) {
        rootTile.tiles[0].remove();
    }
}

function splitHorizontal(rootTile) {
    var candidates = [];
    var i;
    var value;
    var label;

    if (typeof KWin !== "undefined" && typeof KWin.Horizontal !== "undefined") {
        candidates.push(["KWin.Horizontal", KWin.Horizontal]);
    }
    if (typeof Tile !== "undefined" && typeof Tile.Horizontal !== "undefined") {
        candidates.push(["Tile.Horizontal", Tile.Horizontal]);
    }
    candidates.push(["numeric 0", 0]);
    candidates.push(["numeric 1", 1]);
    candidates.push(["numeric 2", 2]);

    for (i = 0; i < candidates.length; ++i) {
        label = candidates[i][0];
        value = candidates[i][1];
        clearTiles(rootTile);
        rootTile.split(value);
        logDelta("splitHorizontal: tried " + label + ", tiles=" + rootTile.tiles.length);
        if (rootTile.tiles.length === 2) {
            return true;
        }
    }

    logDelta("splitHorizontal: no candidate produced 2 tiles");
    return false;
}

function collectLeafWindows(tile, out) {
    var i;
    for (i = 0; i < tile.windows.length; ++i) {
        if (out.indexOf(tile.windows[i]) === -1) {
            out.push(tile.windows[i]);
        }
    }
    for (i = 0; i < tile.tiles.length; ++i) {
        collectLeafWindows(tile.tiles[i], out);
    }
}

function ensureHalvesLayout(rootTile) {
    if (rootTile.tiles.length === 2 &&
        approx(rootTile.tiles[0].relativeGeometry.x, 0) &&
        approx(rootTile.tiles[0].relativeGeometry.width, 0.5) &&
        approx(rootTile.tiles[1].relativeGeometry.x, 0.5) &&
        approx(rootTile.tiles[1].relativeGeometry.width, 0.5)) {
        return true;
    }

    clearTiles(rootTile);
    if (!splitHorizontal(rootTile)) {
        return false;
    }
    logDelta("ensureHalvesLayout: after split tiles=" + rootTile.tiles.length);
    if (!rootTile.tiles[0]) {
        logDelta("ensureHalvesLayout: tiles[0] missing");
        return false;
    }
    if (!rootTile.tiles[1]) {
        logDelta("ensureHalvesLayout: tiles[1] missing");
        return false;
    }
    rootTile.tiles[0].relativeGeometry = {
        x: 0,
        y: 0,
        width: 0.5,
        height: 1
    };
    rootTile.tiles[1].relativeGeometry = {
        x: 0.5,
        y: 0,
        width: 0.5,
        height: 1
    };
    logDelta(
        "ensureHalvesLayout: tiles=" + rootTile.tiles.length +
        " left=(" + rootTile.tiles[0].relativeGeometry.x + "," + rootTile.tiles[0].relativeGeometry.width + ")" +
        " right=(" + rootTile.tiles[1].relativeGeometry.x + "," + rootTile.tiles[1].relativeGeometry.width + ")"
    );
    return rootTile.tiles.length === 2;
}

function layoutLeftWidth(layoutName) {
    if (layoutName === "halves") {
        return 0.5;
    }
    if (layoutName === "thirds_left") {
        return 1 / 3;
    }
    if (layoutName === "thirds_right") {
        return 2 / 3;
    }
    return -1;
}

function ensureTwoColumnLayout(rootTile, layoutName) {
    var leftWidth = layoutLeftWidth(layoutName);
    if (leftWidth < 0) {
        logDelta("ensureTwoColumnLayout: unknown layout " + layoutName);
        return false;
    }

    if (rootTile.tiles.length === 2 &&
        approx(rootTile.tiles[0].relativeGeometry.x, 0) &&
        approx(rootTile.tiles[0].relativeGeometry.width, leftWidth) &&
        approx(rootTile.tiles[1].relativeGeometry.x, leftWidth) &&
        approx(rootTile.tiles[1].relativeGeometry.width, 1 - leftWidth)) {
        return true;
    }

    clearTiles(rootTile);
    if (!splitHorizontal(rootTile)) {
        return false;
    }
    logDelta("ensureTwoColumnLayout(" + layoutName + "): after split tiles=" + rootTile.tiles.length);
    if (!rootTile.tiles[0] || !rootTile.tiles[1]) {
        logDelta("ensureTwoColumnLayout(" + layoutName + "): missing tiles after split");
        return false;
    }
    rootTile.tiles[0].relativeGeometry = {
        x: 0,
        y: 0,
        width: leftWidth,
        height: 1
    };
    rootTile.tiles[1].relativeGeometry = {
        x: leftWidth,
        y: 0,
        width: 1 - leftWidth,
        height: 1
    };
    logDelta(
        "ensureTwoColumnLayout(" + layoutName + "): left=(" +
        rootTile.tiles[0].relativeGeometry.x + "," + rootTile.tiles[0].relativeGeometry.width +
        ") right=(" +
        rootTile.tiles[1].relativeGeometry.x + "," + rootTile.tiles[1].relativeGeometry.width + ")"
    );
    return rootTile.tiles.length === 2;
}

function manageIntoTile(tile, window) {
    var geom = null;
    var area = null;
    if (!tile || !window) return;
    if (typeof tile.manage === "function") {
        tile.manage(window);
    } else {
        window.tile = tile;
    }
    if (typeof workspace.scheduleRearrange === "function") {
        workspace.scheduleRearrange();
    } else if (typeof workspace.rearrange === "function") {
        workspace.rearrange();
    }
    area = workspace.clientArea(KWin.MaximizeArea, window);
    if (area && tile.relativeGeometry) {
        geom = {
            x: Math.round(area.x + area.width * tile.relativeGeometry.x) + tileInsets.left,
            y: Math.round(area.y + area.height * tile.relativeGeometry.y) + tileInsets.top,
            width: Math.round(area.width * tile.relativeGeometry.width) - tileInsets.left - tileInsets.right,
            height: Math.round(area.height * tile.relativeGeometry.height) - tileInsets.top - tileInsets.bottom
        };
        window.frameGeometry = {
            x: geom.x,
            y: geom.y,
            width: geom.width,
            height: geom.height
        };
    } else if (tile.absoluteGeometryInScreen) {
        geom = tile.absoluteGeometryInScreen;
        window.frameGeometry = {
            x: geom.x,
            y: geom.y,
            width: geom.width,
            height: geom.height
        };
    }
}

function tileIntoLayout(layoutName, side) {
    var w = workspace.activeWindow;
    var manager;
    var rootTile;
    var existing = [];
    var slotIndex;
    var otherIndex;
    var i;
    var otherWindow = null;

    if (!w || !w.output) return;
    if (shouldIgnoreWindow(w)) return;

    manager = workspace.tilingForScreen(w.output.name);
    if (!manager || !manager.rootTile) return;
    rootTile = manager.rootTile;

    collectLeafWindows(rootTile, existing);
    if (!ensureTwoColumnLayout(rootTile, layoutName)) return;

    slotIndex = side === "right" ? 1 : 0;
    otherIndex = slotIndex === 0 ? 1 : 0;

    for (i = 0; i < existing.length; ++i) {
        if (existing[i] !== w) {
            otherWindow = existing[i];
            break;
        }
    }

    if (otherWindow) {}

    w.setMaximize(false, false);
    manageIntoTile(rootTile.tiles[slotIndex], w);
}

FUNCS

    while IFS='=' read -r id rest; do
        id="${id// /}"
        read -r key xf wf extra <<< "$rest"
        local ku="$key" kl="${key,,}"
        [[ ${#key} -eq 1 ]] && ku="${key^^}"
        if [[ "$xf" == "fixed" ]]; then
            echo "registerShortcut(\"${id}\", \"Delta: ${id}\", \"Ctrl+Alt+Meta+${ku}\", function() { tileFixed(${wf}, ${extra}); });"
        elif [[ "$xf" == "tile" ]]; then
            echo "registerShortcut(\"${id}\", \"Delta: ${id}\", \"Ctrl+Alt+Meta+${ku}\", function() { tileIntoLayout(\"${wf}\", \"${extra}\"); });"
        else
            echo "registerShortcut(\"${id}\", \"Delta: ${id}\", \"Ctrl+Alt+Meta+${ku}\", function() { tile(\"${kl}\", ${xf}, ${wf}); });"
        fi
    done < <(get_section "bindings")
}

# ─── Commands ──────────────────────────────────────────────────────────────────
_apply_keyd() {
    if [[ -w "$KEYD_CONF" ]]; then
        generate_keyd > "$KEYD_CONF" && keyd reload
    else
        generate_keyd | sudo tee "$KEYD_CONF" > /dev/null && sudo keyd reload
    fi
}

_restart_keyd() {
    [[ -w "$KEYD_CONF" ]] && keyd reload || sudo keyd reload
}

cmd_apply() {
    echo "==> Generating keyd config..."
    _apply_keyd
    echo "    wrote $KEYD_CONF"

    echo "==> Generating KWin script..."
    mkdir -p "$(dirname "$KWIN_SCRIPT")"
    generate_kwin > "$KWIN_SCRIPT"
    _reload_kwin
    echo "    wrote $KWIN_SCRIPT"
    echo "Done."
}

cmd_reload() {
    echo "==> Reloading keyd..."
    _restart_keyd
    echo "==> Reloading KWin script..."
    _reload_kwin
    echo "Done."
}

cmd_render_kwin() {
    echo "==> Generating KWin script..."
    mkdir -p "$(dirname "$KWIN_SCRIPT")"
    generate_kwin > "$KWIN_SCRIPT"
    echo "    wrote $KWIN_SCRIPT"
}

cmd_reload_kwin() {
    echo "==> Reloading KWin script..."
    _reload_kwin
    echo "Done."
}

_reload_kwin() {
    qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.unloadScript "delta-tile" 2>/dev/null || true
    qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.loadScript "$KWIN_SCRIPT" "delta-tile" 2>/dev/null
    qdbus6 org.kde.KWin /Scripting start 2>/dev/null
}

cmd_status() {
    local keyd_state kwin_loaded
    keyd_state=$(systemctl is-active keyd 2>/dev/null)
    kwin_loaded=$(qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.isScriptLoaded "delta-tile" 2>/dev/null)
    echo "keyd service:     $keyd_state"
    echo "kwin script:      ${kwin_loaded:-unknown}"
    echo "config:           $CONF"
    echo "kwin script path: $KWIN_SCRIPT"
    echo "keyd config:      $KEYD_CONF"
}

cmd_setup() {
    if [[ "$EUID" -ne 0 ]]; then
        echo "Run setup with sudo: sudo delta setup"; exit 1
    fi
    local user="${SUDO_USER:-$USER}"
    usermod -aG keyd "$user"
    chgrp keyd /etc/keyd
    chmod g+w /etc/keyd
    touch "$KEYD_CONF"
    chgrp keyd "$KEYD_CONF"
    chmod g+rw "$KEYD_CONF"
    echo "Setup complete."
    echo "Log out and back in for the keyd group to take effect, then run: delta apply"
}

case "${1:-help}" in
    setup)  cmd_setup  ;;
    apply)  cmd_apply  ;;
    reload) cmd_reload ;;
    render-kwin) cmd_render_kwin ;;
    reload-kwin) cmd_reload_kwin ;;
    status) cmd_status ;;
    *)
        echo "Usage: delta <command>"
        echo "  setup   — (once, with sudo) grants passwordless access to keyd config"
        echo "  apply   — regenerate configs from delta.conf and reload everything"
        echo "  reload  — reload keyd + KWin script without regenerating"
        echo "  render-kwin — regenerate only the KWin script"
        echo "  reload-kwin — reload only the KWin script"
        echo "  status  — show current state of all components"
        ;;
esac
